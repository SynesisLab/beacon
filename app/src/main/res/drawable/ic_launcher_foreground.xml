<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon = the in-app Beacon mark (ic_beacon_logo): one lamp
     dot with a three-ray beam fanning up-right, centered on the 108dp
     adaptive-icon canvas (66dp safe zone; rays end ~x87 at 2.4 scale —
     within it). Drawn here at the 24-grid, scaled around the bbox center. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2.4"
        android:scaleY="2.4"
        android:translateX="24.24"
        android:translateY="24.96">
        <!-- Lamp dot (8,17) r2.8 -->
        <path
            android:pathData="M 10.8,17 A 2.8,2.8 0 1 1 5.2,17 A 2.8,2.8 0 1 1 10.8,17 Z"
            android:fillColor="#D97757" />
        <!-- Rays at -75° / -45° / -15°, radius 5→11 -->
        <path
            android:pathData="M 9.3,12.2 L 10.9,6.4"
            android:strokeColor="#D97757"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
        <path
            android:pathData="M 11.5,13.5 L 15.8,9.2"
            android:strokeColor="#D97757"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
        <path
            android:pathData="M 12.8,15.7 L 18.6,14.1"
            android:strokeColor="#D97757"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
    </group>
</vector>